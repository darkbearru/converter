{
  "name": "converter",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "tauri": "tauri",
    "build:macos": "node scripts/build-desktop.mjs aarch64-apple-darwin",
    "build:macos:intel": "node scripts/build-desktop.mjs x86_64-apple-darwin",
    "build:windows": "node scripts/build-desktop.mjs x86_64-pc-windows-msvc",
    "test:build": "node --test scripts/tests/*.test.mjs",
    "dev:harness": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "test:e2e": "playwright test",
    "check:contracts": "node scripts/check-contracts.mjs",
    "format": "prettier --write src tests/ui \"scripts/**/*.mjs\" *.json *.ts index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src tests/ui \"scripts/**/*.mjs\" *.json *.ts index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "capture:ui": "node scripts/capture-ui.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@tauri-apps/api": "^2.12.4",
    "primevue": "4.5.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
