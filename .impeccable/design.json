      "html": "<button class=\"ds-transfer\" aria-label=\"Отмена скачивания\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"38\" height=\"38\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><g transform=\"translate(20 20) scale(2) translate(-20 -20)\"><path d=\"M23,25.5h-6c-1.4,0-2.5-1.1-2.5-2.5v-6c0-1.4,1.1-2.5,2.5-2.5h6c1.4,0,2.5,1.1,2.5,2.5v6C25.5,24.4,24.4,25.5,23,25.5z\n\t\t\t M17,15.5c-0.8,0-1.5,0.7-1.5,1.5v6c0,0.8,0.7,1.5,1.5,1.5h6c0.8,0,1.5-0.7,1.5-1.5v-6c0-0.8-0.7-1.5-1.5-1.5H17z\" fill=\"currentColor\"/></g></svg></button>",
      "css": ".ds-transfer{font:500 14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:.5rem .75rem;border-radius:var(--control-radius,6px);cursor:pointer;transition:background .2s,color .2s,border-color .2s,box-shadow .2s,outline-color .2s;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;color:var(--p-surface-950,#09090b);background:var(--transfer,#65C8EE);}.ds-transfer:hover{background:var(--p-sky-300,#7dd3fc);}.ds-transfer:active{background:var(--transfer,#65C8EE);}.ds-transfer:focus-visible{outline:2px solid var(--focus,#F96133);outline-offset:3px;}.ds-transfer:disabled{opacity:.6;cursor:default}"
