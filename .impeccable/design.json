    {
      "name": "Текстовое поле",
      "kind": "input",
      "refersTo": "input-light",
      "description": "Растягивается по ширине Dialog; label связан с полем.",
      "html": "<label class=\"ds-field-label\" for=\"ds-dictionary-title\">Название словаря</label><input class=\"ds-field\" id=\"ds-dictionary-title\" placeholder=\"Из исходного файла\"/>",
      "css": ".ds-field-label{display:block;margin-bottom:8px;font:600 12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--text,#3f3f46)}.ds-field{font:400 13px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:block;width:100%;min-width:0;padding:.5rem .75rem;border:1px solid var(--p-form-field-border-color,#d4d4d8);border-radius:var(--control-radius,6px);background:var(--p-form-field-background,#ffffff);color:var(--p-form-field-color,#3f3f46);caret-color:var(--accent,#F96133);box-shadow:var(--p-form-field-shadow,0 1px 2px 0 rgba(18,18,23,.05));transition:border-color .2s,box-shadow .2s,outline-color .2s}.ds-field::placeholder{color:var(--p-form-field-placeholder-color,#71717a)}.ds-field:hover{border-color:var(--p-form-field-hover-border-color,#a1a1aa)}.ds-field:focus{border-color:var(--p-form-field-focus-border-color,#F96133)}.ds-field:focus-visible{outline:2px solid var(--focus,#F96133);outline-offset:3px;}.ds-field:disabled{background:var(--p-form-field-disabled-background,#e4e4e7);color:var(--p-form-field-disabled-color,#71717a)}"
    },
