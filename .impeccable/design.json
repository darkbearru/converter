      "html": "<button class=\"ds-convert\" aria-label=\"Запуск конвертации\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"38\" height=\"38\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><g transform=\"translate(20 20) scale(2) translate(-20 -20)\"><path d=\"M17.7,25.5c-1,0-1.7-0.8-1.7-1.7v-7.5c0-1,0.8-1.7,1.7-1.7c0.3,0,0.6,0.1,0.9,0.2l6.5,3.8c0.5,0.3,0.9,0.9,0.9,1.5\n\t\t\ts-0.3,1.2-0.9,1.5l-6.5,3.8C18.3,25.4,18,25.5,17.7,25.5z M17.7,15.5c-0.4,0-0.7,0.3-0.7,0.7v7.5c0,0.6,0.7,0.9,1.1,0.6l6.5-3.8\n\t\t\tc0.2-0.1,0.4-0.4,0.4-0.6s-0.1-0.5-0.4-0.6l-6.5-3.8C18,15.5,17.9,15.5,17.7,15.5z\" fill=\"currentColor\"/></g></svg></button>",
      "css": ".ds-convert{font:500 14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:.5rem .75rem;border-radius:var(--control-radius,6px);cursor:pointer;transition:background .2s,color .2s,border-color .2s,box-shadow .2s,outline-color .2s;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;color:var(--p-surface-950,#09090b);background:var(--accent,#F96133);}.ds-convert:hover{background:var(--p-primary-hover-color,#ff7950);}.ds-convert:active{background:var(--p-primary-active-color,#ff9876);}.ds-convert:focus-visible{outline:2px solid var(--focus,#F96133);outline-offset:3px;}.ds-convert:disabled{opacity:.6;cursor:default}"
    },
    {
      "name": "Отмена скачивания",
      "kind": "button",
      "refersTo": "action-transfer",
